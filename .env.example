# Database (placeholder — never commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google OAuth (Passport login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Cloud Service Account (for @google-cloud/storage)
# Get these from Google Cloud Console > IAM > Service Accounts > Keys (JSON)
# DO NOT expose with VITE_ prefix - server-only
GCS_PROJECT_ID=your_gcp_project_id
GCS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GCS_CLIENT_ID=your_service_account_client_id
GCS_PRIVATE_KEY_ID=your_private_key_id
# Keep the \n literals inside double quotes - dotenv will expand them to newlines
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GCS_BUCKET_NAME=your_gcs_bucket_name

# Session
SESSION_SECRET=your_super_secret_session_key_change_this

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# App
# Empty = same-origin API calls (works in dev via Vite proxy AND in production).
VITE_API_URL=
ADMIN_EMAIL=rare69963@gmail.com
# Server-side admin allowlist (comma-separated). Admin-ness is derived from
# the Google-verified session email — never from client input.
ADMIN_EMAILS=admin1@example.com,admin2@example.com
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Frontend (Vite exposes these to the browser)
VITE_ADMIN_EMAIL=rare69963@gmail.com
VITE_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Workspace mail via Gmail API (server-only — never VITE_ prefixed)
# No SMTP needed. Connect once from /dashboard/workspace (OAuth consent for
# the gmail.modify scope). Add the redirect URI in Google Cloud Console:
#   http://localhost:3001/api/mail/gmail/callback
#   https://YOUR-DOMAIN/api/mail/gmail/callback (production)
# Optional override (defaults are derived from NODE_ENV/FRONTEND_URL):
# GMAIL_REDIRECT_URI=http://localhost:3001/api/mail/gmail/callback
